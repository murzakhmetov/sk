{
  "name": "web-game-3d",
  "version": "0.1.0",
  "private": true,
  "description": "Starter template: procedural 3D city, physics player, arcade car and LLM-driven NPCs (Vite + React Three Fiber + Rapier + Claude).",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p src && tsc -p .",
    "smoke:llm": "tsx scripts/smokeLlm.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/rapier": "^2.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  }
}
